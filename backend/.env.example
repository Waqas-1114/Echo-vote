# Supabase project (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role / secret key. Server-only: never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Secret used to sign login tokens (generate with: openssl rand -base64 32)
JWT_SECRET=change-me

# API server port (the frontend proxies /api here)
PORT=4000
# Optional: comma-separated origins allowed to call the API directly (CORS)
# CORS_ORIGIN=http://localhost:3000
